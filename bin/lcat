#!/bin/bash
# Fetch and display a file from a remote cluster
# Usage: lcat <cluster> <remote_path> [--head N]
#
# Examples:
#   lcat bp logs/examples_epoch_1.jsonl
#   lcat mn logs/examples_epoch_1.jsonl --head 5

if [ $# -lt 2 ]; then
    echo "Usage: lcat <cluster> <remote_path> [--head N]"
    echo "  cluster: bp, mn, is"
    echo "  remote_path: path relative to project work dir"
    exit 1
fi

CLUSTER="$1"
REMOTE_PATH="$2"
HEAD_N=""

if [ "$3" = "--head" ] && [ -n "$4" ]; then
    HEAD_N="$4"
fi

# Load project config (auto-detect from pwd)
source "$(dirname "$0")/../lib/_hpc_project_config"
resolve_project ""

FULL_PATH="~/$WORK_DIR/$REMOTE_PATH"

# Validate path: only allow safe characters (allowlist approach)
if ! echo "$REMOTE_PATH" | grep -qE '^[a-zA-Z0-9_./-]+$'; then
    echo "Error: Remote path contains invalid characters." >&2
    exit 1
fi

# Validate HEAD_N is numeric
if [ -n "$HEAD_N" ] && ! echo "$HEAD_N" | grep -qE '^[0-9]+$'; then
    echo "Error: --head value must be a number." >&2
    exit 1
fi

if [ -n "$HEAD_N" ]; then
    ssh "$CLUSTER" "head -n $HEAD_N ~/$WORK_DIR/$REMOTE_PATH"
else
    ssh "$CLUSTER" "cat ~/$WORK_DIR/$REMOTE_PATH"
fi
