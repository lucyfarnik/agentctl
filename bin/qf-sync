#!/usr/bin/env python3
"""Sync project code to a cluster without submitting a job.

Usage:
    qf-sync <cluster>
"""

import os
import subprocess
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'lib'))
import agentctl


def main():
    if len(sys.argv) != 2:
        print("Usage: qf-sync <cluster>", file=sys.stderr)
        sys.exit(1)

    cluster = sys.argv[1]
    if cluster not in agentctl.CLUSTERS:
        print(f"Error: Unknown cluster '{cluster}'. Use: {', '.join(sorted(agentctl.CLUSTERS))}", file=sys.stderr)
        sys.exit(1)

    project_root = agentctl.find_project_root()
    if not project_root:
        print("Error: Could not find project root (no hpc_utils/copy found).", file=sys.stderr)
        sys.exit(1)

    print(f"[agentctl] WARNING: This overwrites the shared remote directory on {cluster}.")
    print(f"[agentctl] If other agents have synced different code, their queued jobs may be affected.")

    copy_cmd = os.path.join(project_root, 'hpc_utils', 'copy')
    result = subprocess.run([copy_cmd, agentctl.COPY_FLAGS[cluster]], cwd=project_root)
    if result.returncode != 0:
        print("Error: Sync failed.", file=sys.stderr)
        sys.exit(1)

    print(f"[agentctl] Code synced to {cluster}")


if __name__ == '__main__':
    main()
