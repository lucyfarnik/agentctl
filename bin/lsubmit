#!/usr/bin/env python3
"""Submit an HPC job with agent ownership tracking and quota enforcement.

Usage:
    lsubmit --agent-id ID --token TOKEN <cluster> <runner> [runner_args...]
    lsubmit --agent-id ab12cd --token <tok> bp runners/main.py --80g

Authenticate with --agent-id/--token flags (or AGENTCTL_AGENT_ID/AGENTCTL_TOKEN env vars).
Run linit to create a session and get your credentials.
"""

import os
import shlex
import subprocess
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'lib'))
import agentctl


def main():
    agent_id, token, argv = agentctl.parse_agent_flags(sys.argv[1:])

    if len(argv) < 2:
        print("Usage: lsubmit [--agent-id ID --token TOKEN] <cluster> <runner> [args...]", file=sys.stderr)
        print("  e.g. lsubmit --agent-id ab12cd --token <tok> bp runners/main.py --80g", file=sys.stderr)
        sys.exit(1)

    cluster = argv[0]
    runner = argv[1]
    runner_args = argv[2:]

    if cluster not in agentctl.CLUSTERS:
        print(f"Error: Unknown cluster '{cluster}'. Use: {', '.join(sorted(agentctl.CLUSTERS))}", file=sys.stderr)
        sys.exit(1)

    agent_id = agentctl.get_verified_agent(agent_id, token)

    # --- Pre-flight quota check (informational, includes pending reservations) ---
    quota = agentctl.get_quota(agent_id, cluster)
    if quota == 0:
        print(f"Error: Agent {agent_id} has no quota on {cluster} (quota=0).", file=sys.stderr)
        print("Request a quota (requires manual approval, may take hours):", file=sys.stderr)
        print(f"  export YES_I_KNOW_THIS_WILL_BE_SLOW=1 && ladmin quota set {agent_id} {cluster} <number>", file=sys.stderr)
        sys.exit(1)

    active = agentctl.count_active_agent_jobs(agent_id, cluster)
    if active >= quota:
        print(f"Error: Quota exceeded on {cluster} ({active}/{quota} active jobs).", file=sys.stderr)
        print("Cancel a job first or ask the user to raise your quota.", file=sys.stderr)
        sys.exit(1)

    print(f"[agentctl] Agent {agent_id}: {active}/{quota} active jobs on {cluster}")

    # --- Find project root and resolve remote path ---
    project_root = agentctl.find_project_root()
    if not project_root:
        print("Error: Could not find project root (no hpc_utils/copy found).", file=sys.stderr)
        print("Run from within the project directory.", file=sys.stderr)
        sys.exit(1)

    project_alias, remote_work_dir = agentctl.resolve_project(project_root)
    if not remote_work_dir:
        print("Error: Project not found in config/.hpc_projects.", file=sys.stderr)
        print("Add your project to ~/CLIs/agentctl/config/.hpc_projects first.", file=sys.stderr)
        print("Format: alias:remote_work_dir:local_logs_dir", file=sys.stderr)
        sys.exit(1)

    print(f"[agentctl] Project: {project_alias} (~/{remote_work_dir})")

    # === PHASE 1: Reserve quota slot ===
    args_str = ' '.join(shlex.quote(a) for a in [runner] + runner_args)
    ok, reservation_id, active_count, quota = agentctl.reserve_quota_slot(
        agent_id, cluster, args_str
    )
    if not ok:
        if quota == 0:
            print(f"Error: Agent {agent_id} has no quota on {cluster}.", file=sys.stderr)
        else:
            print(f"Error: Quota exceeded on {cluster} ({active_count}/{quota} active jobs).", file=sys.stderr)
        sys.exit(1)

    print(f"[agentctl] Reserved slot ({active_count + 1}/{quota} on {cluster})")

    # === PHASE 2: Sync + Submit (with cleanup on failure) ===
    maybe_submitted = False  # True once SSH command is sent (job may exist on cluster)
    job_id = None

    try:
        # --- Sync code ---
        copy_flag = agentctl.COPY_FLAGS[cluster]
        print(f"[agentctl] Syncing code to {cluster}...")
        print(f"[agentctl] WARNING: Code sync overwrites the shared remote directory.")
        print(f"[agentctl] If other agents have synced different code, this will overwrite it.")
        copy_cmd = os.path.join(project_root, 'hpc_utils', 'copy')
        result = subprocess.run([copy_cmd, copy_flag], cwd=project_root)
        if result.returncode != 0:
            print("Error: Code sync failed.", file=sys.stderr)
            sys.exit(1)

        # --- Submit job ---
        remote_cmd = f"cd ~/{remote_work_dir} && ./hpc_utils/run {args_str}"
        print(f"[agentctl] Submitting: {args_str}")
        maybe_submitted = True  # SSH is about to run — job may exist after this point
        try:
            result = subprocess.run(
                ['ssh', cluster, remote_cmd],
                capture_output=True, text=True, timeout=120,
            )
        except (subprocess.TimeoutExpired, KeyboardInterrupt):
            print("Error: SSH interrupted or timed out. Job may have been submitted.", file=sys.stderr)
            print(f"Check with: lq {cluster}", file=sys.stderr)
            sys.exit(1)

        if result.returncode != 0:
            maybe_submitted = False  # sbatch explicitly failed — no job exists
            print(f"Error: Job submission failed.", file=sys.stderr)
            if result.stderr:
                print(result.stderr, file=sys.stderr)
            if result.stdout:
                print(result.stdout, file=sys.stderr)
            sys.exit(1)

        # Parse job ID from sbatch output: "Submitted batch job 12345"
        for line in (result.stdout + result.stderr).strip().split('\n'):
            if 'Submitted batch job' in line:
                job_id = line.strip().split()[-1]
                break

        if not job_id:
            # sbatch returned 0 but we can't parse the ID — job likely exists
            print("Warning: Could not parse job ID from output:", file=sys.stderr)
            print(result.stdout, file=sys.stderr)
            print(result.stderr, file=sys.stderr)
            print(f"Job may be running. Check with: lq {cluster}", file=sys.stderr)
            sys.exit(1)  # maybe_submitted stays True → reservation kept

        # === PHASE 3: Finalize reservation ===
        try:
            agentctl.finalize_reservation(agent_id, reservation_id, job_id, cluster, args_str)
        except Exception as e:
            print(f"Warning: Could not finalize reservation: {e}", file=sys.stderr)
            print(f"Job {job_id} is running but may not be fully tracked.", file=sys.stderr)

        print(f"[agentctl] Job {job_id} submitted on {cluster} (agent {agent_id}, {active_count + 1}/{quota} active)")

    finally:
        if not maybe_submitted:
            # Job was definitely never submitted — safe to release reservation
            agentctl.cancel_reservation(agent_id, reservation_id)
            print("[agentctl] Reservation released.", file=sys.stderr)
        elif not job_id:
            # Job may exist but we don't have the ID — keep reservation for reaper
            print(f"[agentctl] Reservation kept (unknown job state). Reaper will clean up.", file=sys.stderr)


if __name__ == '__main__':
    main()
