#!/usr/bin/env python3
"""Admin tool for managing agentctl quotas and sessions.

Not token-gated — meant for the human user, not agents.

Usage:
    qf-admin quota set <agent_id> <cluster> <limit>
    qf-admin quota get <agent_id> <cluster>
    qf-admin quota list
    qf-admin sessions list
    qf-admin sessions delete <agent_id>
"""

import json
import os
import shutil
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'lib'))
import agentctl


def load_quotas():
    qf = os.path.join(agentctl.CONFIG_DIR, 'quotas.json')
    if not os.path.exists(qf):
        return {"default": {"bp": 0, "is": 0, "mn": 0}, "agents": {}}
    with open(qf) as f:
        return json.load(f)


def save_quotas(quotas):
    qf = os.path.join(agentctl.CONFIG_DIR, 'quotas.json')
    with open(qf, 'w') as f:
        json.dump(quotas, f, indent=2)
    print(f"Saved {qf}")


def cmd_quota_set(args):
    if len(args) != 3:
        print("Usage: qf-admin quota set <agent_id> <cluster> <limit>", file=sys.stderr)
        sys.exit(1)
    agent_id, cluster, limit = args
    if cluster not in agentctl.CLUSTERS:
        print(f"Error: Unknown cluster '{cluster}'. Use: {', '.join(sorted(agentctl.CLUSTERS))}", file=sys.stderr)
        sys.exit(1)
    try:
        limit = int(limit)
    except ValueError:
        print(f"Error: Limit must be an integer.", file=sys.stderr)
        sys.exit(1)
    quotas = load_quotas()
    if agent_id not in quotas.get('agents', {}):
        quotas.setdefault('agents', {})[agent_id] = {}
    quotas['agents'][agent_id][cluster] = limit
    save_quotas(quotas)
    print(f"Set quota: agent {agent_id} on {cluster} = {limit}")


def cmd_quota_get(args):
    if len(args) != 2:
        print("Usage: qf-admin quota get <agent_id> <cluster>", file=sys.stderr)
        sys.exit(1)
    agent_id, cluster = args
    quota = agentctl.get_quota(agent_id, cluster)
    print(f"Agent {agent_id} on {cluster}: quota={quota}")


def cmd_quota_list(args):
    quotas = load_quotas()
    print("Default quotas:")
    for cluster, limit in sorted(quotas.get('default', {}).items()):
        print(f"  {cluster}: {limit}")
    agents = quotas.get('agents', {})
    if agents:
        print("\nAgent-specific quotas:")
        for agent_id, clusters in sorted(agents.items()):
            for cluster, limit in sorted(clusters.items()):
                print(f"  {agent_id} on {cluster}: {limit}")
    else:
        print("\nNo agent-specific quotas set.")


def cmd_sessions_list(args):
    sessions_dir = agentctl.SESSIONS_DIR
    if not os.path.exists(sessions_dir):
        print("No sessions.")
        return
    for entry in sorted(os.listdir(sessions_dir)):
        session_dir = os.path.join(sessions_dir, entry)
        if not os.path.isdir(session_dir):
            continue
        identity_file = os.path.join(session_dir, 'identity.json')
        if os.path.exists(identity_file):
            with open(identity_file) as f:
                identity = json.load(f)
            jobs = agentctl.load_jobs(entry)
            print(f"  {entry}: name={identity.get('name', '')!r}, created={identity.get('created_at', '?')}, jobs={len(jobs)}")
        else:
            print(f"  {entry}: (no identity.json)")


def cmd_sessions_delete(args):
    if len(args) != 1:
        print("Usage: qf-admin sessions delete <agent_id>", file=sys.stderr)
        sys.exit(1)
    agent_id = args[0]
    session_dir = os.path.join(agentctl.SESSIONS_DIR, agent_id)
    if not os.path.isdir(session_dir):
        print(f"Error: No session found for '{agent_id}'.", file=sys.stderr)
        sys.exit(1)
    shutil.rmtree(session_dir)
    print(f"Deleted session {agent_id}")


def main():
    if len(sys.argv) < 2:
        print(__doc__)
        sys.exit(1)

    cmd = sys.argv[1]
    subcmd = sys.argv[2] if len(sys.argv) > 2 else ''
    rest = sys.argv[3:]

    if cmd == 'quota':
        if subcmd == 'set':
            cmd_quota_set(rest)
        elif subcmd == 'get':
            cmd_quota_get(rest)
        elif subcmd == 'list':
            cmd_quota_list(rest)
        else:
            print("Usage: qf-admin quota [set|get|list]", file=sys.stderr)
            sys.exit(1)
    elif cmd == 'sessions':
        if subcmd == 'list':
            cmd_sessions_list(rest)
        elif subcmd == 'delete':
            cmd_sessions_delete(rest)
        else:
            print("Usage: qf-admin sessions [list|delete]", file=sys.stderr)
            sys.exit(1)
    else:
        print(f"Unknown command: {cmd}", file=sys.stderr)
        print(__doc__)
        sys.exit(1)


if __name__ == '__main__':
    main()
