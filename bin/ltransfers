#!/bin/zsh

# Check rsync transfer status between clusters
# Usage: ltransfers [source_cluster]
#   ltransfers        - check all clusters for active rsync transfers
#   ltransfers bp     - check transfers running on BluePebble
#   ltransfers mn     - check transfers running on MareNostrum
#   ltransfers is     - check transfers running on Isambard

check_transfers() {
    local cluster=$1
    local label=$2

    # Show active rsync processes
    local procs=$(ssh "$cluster" 'ps aux | grep "rsync.*huggingface\|rsync.*transfer\|rsync.*bris312491\|rsync.*work/" | grep -v grep' 2>/dev/null)

    if [[ -z "$procs" ]]; then
        echo "  No active rsync transfers"
    else
        echo "  Active transfers:"
        echo "$procs" | while read -r line; do
            # Extract the model/path being transferred
            local src=$(echo "$line" | grep -oE '/[^ ]*huggingface/hub/models--[^ ]*' | head -1 | sed 's|.*/models--|  → |')
            if [[ -n "$src" ]]; then
                echo "$src"
            else
                echo "  → $(echo "$line" | awk '{for(i=11;i<=NF;i++) printf "%s ", $i; print ""}')"
            fi
        done
    fi
}

case "${1:-all}" in
    bp|b|-b)
        echo "=== BluePebble ==="
        check_transfers bp "BluePebble"
        ;;
    mn|m|-m)
        echo "=== MareNostrum ==="
        check_transfers mn "MareNostrum"
        ;;
    is|i|-i)
        echo "=== Isambard ==="
        check_transfers is "Isambard"
        ;;
    all|"")
        echo "=== BluePebble ==="
        check_transfers bp "BluePebble"
        echo ""
        echo "=== MareNostrum ==="
        check_transfers mn "MareNostrum"
        echo ""
        echo "=== Isambard ==="
        check_transfers is "Isambard"
        ;;
    *)
        echo "Usage: ltransfers [bp|mn|is]"
        echo "  ltransfers      - all clusters"
        echo "  ltransfers bp   - BluePebble only"
        exit 1
        ;;
esac
